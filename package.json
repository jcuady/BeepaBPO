{
  "name": "beepa",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "db:types": "supabase gen types typescript --linked > types/database.ts",
    "db:push": "supabase db push --yes",
    "create-owner": "node --experimental-strip-types scripts/create-owner.mts",
    "seed:demo": "node --experimental-strip-types scripts/seed-demo.mts",
    "smoke:cron": "node --env-file=.env.local scripts/smoke-cron.mjs",
    "brand:icons": "node scripts/generate-google-brand-assets.cjs"
  },
  "dependencies": {
    "@base-ui/react": "^1.8.0",
