# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage
/test-results/
/playwright-report/
/blob-report/

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
dev-server.log
dev-server.err
prod-server.log
prod-server.err
role-pages-out.txt

# local test/reporting artifacts
vitest-out.json

# Playwright persisted auth state (regenerated by e2e/auth.setup.ts)
.auth/

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

.vercel

# Claude SEO clone (install from GitHub; do not commit the vendor tree)
/claude-seo/

# Local junctions/copies of global Claude SEO (machine-specific)
.claude/skills/seo/
.claude/skills/seo-*/
.claude/agents/seo-*.md
# Keep the Beepa project entry skill in git
!.claude/skills/seo-beepa/
!.claude/skills/seo-beepa/**
# local QA server log
.qa-*.log
# Role-sweep working file. The reviewed copy is docs/evidence/role-sweep.json, which IS
# tracked; this root artifact is regenerated on every run and is only a working copy.
.qa-sweep-report.json
